# ==============================================================================
# BookTower Configuration Template
# Copy this file to .env and adjust values as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# External API Keys
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# LLM Configuration
# ------------------------------------------------------------------------------
LLM_MODEL_NAME=your_llm_model_name_here
LLM_TEMPERATURE=your_llm_temperature_here

# ------------------------------------------------------------------------------
# Assets & Data Paths
# Paths can be relative to project root or absolute
# ------------------------------------------------------------------------------
ASSETS_PATH=assets
MAP_DIR=assets/map
TIMETABLES_PATH=assets/timetables
RECS_PATH=assets/recs/recs.json
PARTICIPANTS_PATH=assets/participants/participants.json

# ------------------------------------------------------------------------------
# Admin Console Configuration
# ------------------------------------------------------------------------------
ADMIN_HOST=admin_Panel_Ip
ADMIN_PORT=admin_panel_port
ADMIN_AUTH_DB_PATH=assets/db/admin_users.db
ADMIN_SESSION_COOKIE_NAME=booktower_admin_session
ADMIN_SESSION_TIMEOUT_SECONDS=86400
